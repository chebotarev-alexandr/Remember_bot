# Скопируйте в .env и заполните
BOT_TOKEN=123456789:AA...
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*

# Календари: Google Calendar OAuth (Desktop-приложение, из Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://bot.code-orbit.ru/callback/google/

# Календари: Яндекс OAuth (приложение на https://oauth.yandex.ru, scope calendar:all)
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
# YANDEX_OAUTH_REDIRECT_URI=https://bot.code-orbit.ru/callback/yandex/

# CALENDAR_EVENT_DURATION_MINUTES=30
# CALENDAR_SYNC_INTERVAL_SECONDS=300
